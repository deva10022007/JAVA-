import java.util.Arrays;
public class Main {
    public static void main(String[] args) {
        int n = 5;
        char[][] a = new char[n][n];

        for (int i = 0; i < n; i++) {
            Arrays.fill(a[i], ' ');
        }

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                if (j == 0 || j == n - 1 || 
                   (i == j && i <= n / 2) || 
                   (i + j == n - 1 && i <= n / 2)) {
                    a[i][j] = '*';
                }
            }
        }

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                System.out.print(a[i][j] + " ");
            }
            System.out.println();
        }
    }
}
