public class Main 
{
    public static int mat(int a, int b) 
    {
        int big = Math.max(a, b);
        int small = Math.min(a, b);
        int s = big;

        while (true) 
        {
            if (big % small == 0) 
            {
                break;
            }
            big = big + s;
        }
        return big;
    }

    public static void main(String[] args) 
    {
        int[] a = {10, 8, 5, 23, 58, 85, 13, 5};
        int lcm = a[0];

        for (int i = 1; i < a.length; i++) 
        {
            lcm = mat(lcm, a[i]);
        }

        System.out.println("The lcm is :" + lcm);
    }
}
