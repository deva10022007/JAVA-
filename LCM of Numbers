public class Main 
{
    public static int mat(int a , int b)
    {
        int big = Math.max(a,b);
        int small = Math.min(a,b);
        int s = big;
            if(big%small == 0)
        while(true)
        {
            break;
            big = big+s;
        }
        return big;
    }
    public static void main(String[] args)
    {
    int []a = {10,8,5,23,58,85,13,5};
    int lcm = a[0];
    {
        for(int i = 0 ; i<7 ;i++)
        {
            lcm=mat(lcm,a[i]);
        }
    }
    System.out.println("The lcm is :"+lcm);
}
}
