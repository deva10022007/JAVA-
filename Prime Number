public class Main 
{
    public static void main(String[] args)
    {
        boolean flag;
        int d;
        int n;
        for(int i = 100; i < 999; i++)
        {
            flag = true;
            n = i;
            while(n != 0)
            {
                d = n % 10;
                if(d != 7 && d != 5 && d != 3 && d != 2)
                {
                    flag = false;
                    break;
                }
                n = n / 10;
            }
            if(flag)
                System.out.println(i);
        }
    }
}
